{
  "name": "rocketball",
  "private": true,
  "version": "1.0.0",
  "description": "ROCKETBALL — throw a touchdown, kick a goal, hit a home run. With rockets.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "node scripts/e2e-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "playwright-core": "^1.56.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
